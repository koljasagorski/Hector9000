[Unit]
Description=Hector9000 WebUI (cage + Chromium kiosk on tty1)
Documentation=file:///opt/hector9000/backend/deploy/README.md
After=systemd-user-sessions.service plymouth-quit-wait.service getty@tty1.service mosquitto.service hector-controller.service
Wants=hector-controller.service
# tty1 belongs either to the kiosk or to the maintenance menu
Conflicts=getty@tty1.service hector-maint.service
# secret "leave fullscreen" (clean exit) or a kiosk that keeps failing
# lands in the maintenance menu instead of a black screen
OnSuccess=hector-maint.service
OnFailure=hector-maint.service
StartLimitIntervalSec=120
StartLimitBurst=5
PartOf=hector.target

[Service]
Type=simple
User=hector
Group=hector
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=HECTOR_WEBUI_DIR=/opt/hector9000/webui
# kiosk.sh serves the UI over http://127.0.0.1, so no file-access flag is needed
Environment="HECTOR_KIOSK_FLAGS=--ozone-platform=wayland"
Environment=WLR_LIBINPUT_NO_DEVICES=1
# deliberately no EnvironmentFile=hector.env: Chromium renders web content and must not
# inherit the admin password or the Matrix token
ExecStart=/usr/local/bin/hector-kiosk-session
Restart=on-failure
RestartSec=5

[Install]
WantedBy=hector.target
