# Optional input for build-image.sh --access-file: bakes a Wi-Fi and/or an SSH login into the image.
# Copy this file OUTSIDE the repository (e.g. ~/.config/hector9000-image/access.env, chmod 600),
# fill it in, and never commit it. An image built with it contains these credentials: do not publish it.
# Plain KEY=VALUE lines (parsed, not executed); one pair of quotes around a value is removed.

# Wi-Fi that the Pi joins by itself when it is in range (WPA-PSK, 8..63 characters)
WIFI_SSID=your-ssid
WIFI_PSK=your-wifi-password
# regulatory domain, two letters; without it the radio may stay blocked
WIFI_COUNTRY=DE

# SSH login (sshd is enabled; password login). The name is case sensitive.
SSH_USER=your-login
SSH_PASSWORD=your-password
# 1: the login may use sudo (with its password), 0: no sudo
SSH_SUDO=1
