# Template for /etc/hector9000/hector.env (root:hector, mode 0640).
# deploy/provision.sh copies this file ONCE (never overwrites). Put real
# values only into /etc/hector9000/hector.env on the Pi, never into the repo.
#
# Read by the systemd units (EnvironmentFile=). Format: KEY=value, no quotes, no "export".

# Do NOT set HECTOR_STATE_DIR here: the unit sets it (/var/lib/hector9000/stats) and a line in this
# file would override it.

# Password of the admin dashboard. Empty = the stats server generates one on
# the first start and stores it in /var/lib/hector9000/stats (see deploy/README.md).
HECTOR_ADMIN_PASSWORD=

# 1 (default) = the admin dashboard answers on the network (plain HTTP!),
# 0 = only from this machine, use "ssh -L 8080:localhost:8080 ..." to reach it.
HECTOR_ADMIN_REMOTE=1

# Matrix error notifications (empty = disabled). Alternatively set them in the admin
# dashboard (tab "Chat"); what is saved there (notify.json in /var/lib/hector9000/stats) wins over these lines.
HECTOR_MATRIX_HOMESERVER=
HECTOR_MATRIX_ROOM=
HECTOR_MATRIX_TOKEN=
